GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
# PostgreSQL Connection (Supabase or Local)
DATABASE_URL=postgresql://user:password@localhost:5432/mu_hive

# Optional orchestrator time window (last N days)
# ORCHESTRATOR_SINCE_DAYS=7

# Shared logging (single file for all agents/scripts)
# MU_HIVE_LOG_FILE=logs/mu_hive.log
# MU_HIVE_LOG_LEVEL=INFO

# Gmail Configuration for Newsletters
GMAIL_SENDER=your_sending_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password

# Fallback Search API (Optional but recommended if DuckDuckGo gets rate-limited)
# Get a free key at https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

FIRECRAWL_API_KEY=your_firecrawl_api_key_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

#Optional but recommended to avoid Groq rate limits/quotas
OpenRouter fallback API Key = your_openrouter_api_key_here

# Zulip Bot Credentials (Optional - Falls back to ~/.zuliprc)
# Pattern: ZULIP_<IG_NAME_UPPER>_EMAIL / ZULIP_<IG_NAME_UPPER>_KEY
ZULIP_AI_EMAIL=your_ai_bot_email
ZULIP_AI_KEY=your_ai_bot_key
ZULIP_CYBER_SECURITY_EMAIL=your_cs_bot_email
ZULIP_CYBER_SECURITY_KEY=your_cs_bot_key
ZULIP_WEB_DEVELOPMENT_EMAIL=your_wd_bot_email
ZULIP_WEB_DEVELOPMENT_KEY=your_wd_bot_key
